---
import '../styles/global.css';

interface Props {
  title?: string;
}

const { title = 'Elizabeth Hau' } = Astro.props;
const description = 'Software engineer. Cloud architect. AI engineer. Building data and AI systems end-to-end.';
const url = 'https://elizabethhau.github.io';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="canonical" href={url} />
    <link rel="icon" type="image/png" href="/favicon.png" />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={url} />
    <meta property="og:title" content="Elizabeth Hau — AI Architect & Engineer" />
    <meta property="og:description" content={description} />

    <!-- Cloudflare Web Analytics -->
    <script defer src="https://static.cloudflareinsights.com/beacon.min.js" data-cf-beacon='{"token": "e45bd8e287b24b97b31d6a0e5937421d"}'></script>

    <title>{title}</title>
  </head>
  <body>
    <slot />
  </body>
</html>
