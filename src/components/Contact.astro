---

<section id="contact">
  <div class="section-label">// 05 &nbsp; contact</div>
  <h2>Let's connect</h2>
  <div class="contact-block">
    <div class="contact-tag">// not looking, but listening</div>
    <p>Interested in working together or just want to say hello? I'd love to hear from you.</p>
    <a href="mailto:elizabeth.h.hau@gmail.com" class="btn-primary">Say Hello</a>
  </div>
</section>

<style>
  section {
    max-width: 920px;
    margin: 0 auto;
    padding: 72px 56px;
    border-top: 1px solid var(--border);
  }

  h2 {
    font-family: var(--font-sans);
    font-size: 30px;
    font-weight: 700;
    letter-spacing: -0.02em;
    margin-bottom: 44px;
    color: var(--text-primary);
  }

  .contact-block {
    background: var(--bg-surface);
    border: 1px solid var(--border);
    padding: 52px;
    text-align: center;
  }

  .contact-tag {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--accent);
    background: var(--accent-dim);
    border: 1px solid rgba(0, 255, 136, 0.25);
    padding: 4px 12px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    margin-bottom: 20px;
  }

  .contact-block p {
    font-family: var(--font-sans);
    font-size: 16px;
    color: var(--text-secondary);
    max-width: 400px;
    margin: 0 auto 32px;
    line-height: 1.7;
  }

  @media (max-width: 768px) {
    section {
      padding: 56px 24px;
    }

    h2 {
      font-size: 24px;
      margin-bottom: 32px;
    }

    .contact-block {
      padding: 36px 24px;
    }
  }
</style>
